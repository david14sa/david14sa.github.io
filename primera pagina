<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Portafolio de Fotografía</title>
  <style>
    /* Estilos generales */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #121212;
      color: #e0e0e0;
      line-height: 1.6;
    }

    /* Navegación */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 5%;
      background-color: #1a1a1a;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .logo {
      font-size: 1.5rem;
      font-weight: bold;
      letter-spacing: 2px;
      color: #fff;
    }
    nav a {
      color: #aaa;
      text-decoration: none;
      margin-left: 1.5rem;
      transition: color 0.3s;
    }
    nav a:hover {
      color: #fff;
    }

    /* Hero / Portada */
    .hero {
      text-align: center;
      padding: 4rem 1rem;
      background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://picsum.photos/1200/500?grayscale') center/cover no-repeat;
    }
    .hero h1 {
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      color: #fff;
    }
    .hero p {
      color: #ccc;
      font-size: 1.1rem;
    }

    /* Galería */
    .container {
      max-width: 1200px;
      margin: 3rem auto;
      padding: 0 1rem;
    }
    .section-title {
      text-align: center;
      margin-bottom: 2rem;
      font-size: 1.8rem;
      letter-spacing: 1px;
    }
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    .gallery-item {
      overflow: hidden;
      border-radius: 8px;
      background-color: #1e1e1e;
    }
    .gallery-item img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .gallery-item:hover img {
      transform: scale(1.05);
    }

    /* Acerca de */
    .about {
      background-color: #1a1a1a;
      padding: 3rem 1rem;
      text-align: center;
    }
    .about p {
      max-width: 700px;
      margin: 0 auto;
      color: #bbb;
    }

    /* Contacto y Pie de página */
    footer {
      text-align: center;
      padding: 2rem;
      background-color: #101010;
      color: #777;
      font-size: 0.9rem;
    }
    .contact-btn {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.75rem 1.5rem;
      background-color: #fff;
      color: #000;
      text-decoration: none;
      border-radius: 4px;
      font-weight: bold;
      transition: background-color 0.3s;
    }
    .contact-btn:hover {
      background-color: #ccc;
    }
  </style>
</head>
<body>

  <!-- Encabezado y Menú -->
  <header>
    <div class="logo">FOTO // LENS</div>
    <nav>
      <a href="#galeria">Galería</a>
      <a href="#sobre-mi">Sobre mí</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </header>

  <!-- Sección Principal / Hero -->
  <section class="hero">
    <h1>Capturando momentos únicos</h1>
    <p>Fotografía de paisaje, retrato y estilo de vida</p>
  </section>

  <!-- Galería de Fotos -->
